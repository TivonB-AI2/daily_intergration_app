AIS_API_BASE_URL=https://api.squared.ai
AIS_AUTH_ENABLED=true
VITE_API_BASE_URL=https://api.squared.ai
VITE_APP_ID=
WORKSPACE_ID=

# App-scoped credentials for public-link mode (only used when AIS_AUTH_ENABLED=false).
# Platform-injected, not set by hand. platformRequest() sends them as the
# Agentic-App-Id / Agentic-App-Token headers in place of a user Bearer token.
APPGEN_APP_ID=
APPGEN_APP_TOKEN=

# Database — operator-controlled. Leave unset for frontend-only apps.
# When set, DB server functions become usable; run `bun run db:migrate` to apply schema.
DATABASE_URL=

# S3 object storage — platform-injected via SandboxEnvInjector. Never set manually.
# Credentials are STS temporary triples (up to 12h lifetime). s3Enabled=true
# when S3_ACCESS_KEY + S3_SECRET_KEY + S3_BUCKET + S3_PREFIX + (S3_REGION or
# S3_ENDPOINT) are all present.
S3_REGION=                  # e.g. us-east-1 (production AWS path)
S3_ENDPOINT=                # optional override; set for local dev with MinIO/R2
S3_ACCESS_KEY=
S3_SECRET_KEY=
AWS_SESSION_TOKEN=          # STS only; absent for permanent IAM (local dev)
S3_BUCKET=
S3_PREFIX=
S3_TOKEN_LIFETIME=          # STS token lifetime in seconds (e.g. 43200 = 12h)
# Note: credential refresh authenticates as the signed-in user via the
# ais-auth-cookie (no separate refresh token). It works inside authenticated
# requests, which is where S3 ops run in an auth-gated app.
